load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//bazel:search.bzl", "search_build_binary", "search_typecheck")

package(default_visibility = ["//visibility:public"])

exports_files([
    "package.json",
    "bunfig.toml",
    "bun.lock",
    "tsconfig.json",
    "README.md",
])

filegroup(
    name = "root_sources",
    srcs = glob(
        [
            "*.bazel",
            "*.json",
            "*.md",
            "*.toml",
            "bun.lock",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "all_sources",
    srcs = [
        ":root_sources",
        "//bazel:sources",
        "//demo:sources",
        "//guest:sources",
        "//index:sources",
        "//src:sources",
        "//test:sources",
        "//tools:sources",
    ],
)

# ---------------------------------------------------------------------------
# AgentOS plane B runtime artifacts (from git module @agent-os)
# ---------------------------------------------------------------------------
genrule(
    name = "agentos_runtime_assets",
    srcs = [
        "@agent-os//memcontainers/kernel/rust:kernel",
        "@agent-os//memcontainers/sdk-js/core:bundle",
        "@agent-os//memcontainers/lib/catalog-compiler:wasm",
    ],
    outs = [
        "runtime/kernel.wasm",
        "runtime/mc-core.mjs",
        "runtime/catalog-compiler.wasm",
    ],
    cmd = "mkdir -p $(@D)/runtime && " +
          "cp $(location @agent-os//memcontainers/kernel/rust:kernel) $(@D)/runtime/kernel.wasm && " +
          "cp $(location @agent-os//memcontainers/sdk-js/core:bundle) $(@D)/runtime/mc-core.mjs && " +
          "cp $(location @agent-os//memcontainers/lib/catalog-compiler:wasm) $(@D)/runtime/catalog-compiler.wasm",
)

# Product image = atlas + searchd (built here against @agent-os)
alias(
    name = "product_image",
    actual = "//guest/image:search_atlas",
)

search_build_binary(
    name = "bundles",
    chdir = ".",
    fixed_args = [
        "tools/build-bundles.mjs",
    ],
    out_dir = "dist-bundles",
    srcs = [
        "//:all_sources",
    ],
)

genrule(
    name = "pick_main_bundle",
    srcs = [":bundles"],
    outs = ["agentos-search.mjs"],
    cmd = "cp $(location :bundles)/agentos-search.mjs $@",
)

genrule(
    name = "pick_runtime_bundle",
    srcs = [":bundles"],
    outs = ["agentos-search-runtime.mjs"],
    cmd = "cp $(location :bundles)/agentos-search-runtime.mjs $@",
)

genrule(
    name = "pick_worker_bundle",
    srcs = [":bundles"],
    outs = ["agentos-search-sw.mjs"],
    cmd = "cp $(location :bundles)/agentos-search-sw.mjs $@",
)

genrule(
    name = "pick_embed_bundle",
    srcs = [":bundles"],
    outs = ["agentos-search-embed.mjs"],
    cmd = "cp $(location :bundles)/agentos-search-embed.mjs $@",
)

genrule(
    name = "model_assets",
    srcs = [
        "@mxbai_embed_xsmall_v1_uint8//file",
        "@mxbai_embed_xsmall_v1_tokenizer//file",
        "@mxbai_embed_xsmall_v1_tokenizer_config//file",
        "@mxbai_embed_xsmall_v1_config//file",
        "@agentos_search_ort_runtime_js//file",
        "@agentos_search_ort_runtime_wasm//file",
    ],
    outs = [
        "model/model.onnx",
        "model/tokenizer.json",
        "model/tokenizer_config.json",
        "model/config.json",
        "model/runtime/ort-wasm-simd-threaded.jsep.mjs",
        "model/runtime/ort-wasm-simd-threaded.jsep.wasm",
    ],
    cmd = "mkdir -p $(@D)/model/runtime && " +
          "cp $(location @mxbai_embed_xsmall_v1_uint8//file) $(@D)/model/model.onnx && " +
          "cp $(location @mxbai_embed_xsmall_v1_tokenizer//file) $(@D)/model/tokenizer.json && " +
          "cp $(location @mxbai_embed_xsmall_v1_tokenizer_config//file) $(@D)/model/tokenizer_config.json && " +
          "cp $(location @mxbai_embed_xsmall_v1_config//file) $(@D)/model/config.json && " +
          "cp $(location @agentos_search_ort_runtime_js//file) $(@D)/model/runtime/ort-wasm-simd-threaded.jsep.mjs && " +
          "cp $(location @agentos_search_ort_runtime_wasm//file) $(@D)/model/runtime/ort-wasm-simd-threaded.jsep.wasm",
)

genrule(
    name = "manifest",
    srcs = [
        ":pick_main_bundle",
        ":pick_worker_bundle",
        ":pick_runtime_bundle",
        ":pick_embed_bundle",
        ":runtime/kernel.wasm",
        ":product_image",
        ":runtime/catalog-compiler.wasm",
        ":runtime/mc-core.mjs",
        "//index:schema.sql",
        "//guest/searchd:protocol",
        ":model/model.onnx",
        ":model/tokenizer.json",
        ":model/tokenizer_config.json",
        ":model/config.json",
        ":model/runtime/ort-wasm-simd-threaded.jsep.mjs",
        ":model/runtime/ort-wasm-simd-threaded.jsep.wasm",
        "//tools:manifest.mjs",
    ],
    outs = ["agentos-search.manifest.json"],
    cmd = "$(location @bun//:bun) $(location //tools:manifest.mjs) $@ " +
          "$(location :pick_main_bundle) " +
          "$(location :pick_worker_bundle) " +
          "$(location :pick_runtime_bundle) " +
          "$(location :pick_embed_bundle) " +
          "$(location :runtime/kernel.wasm) " +
          "$(location :product_image) " +
          "$(location //index:schema.sql) " +
          "$(location :runtime/catalog-compiler.wasm) " +
          "$(location //guest/searchd:protocol) " +
          "NONE " +
          "$(location :runtime/mc-core.mjs) " +
          "--model " +
          "$(location :model/model.onnx) " +
          "$(location :model/tokenizer.json) " +
          "$(location :model/tokenizer_config.json) " +
          "$(location :model/config.json) " +
          "$(location :model/runtime/ort-wasm-simd-threaded.jsep.mjs) " +
          "$(location :model/runtime/ort-wasm-simd-threaded.jsep.wasm)",
    tools = ["@bun//:bun"],
)

# Copy-and-import directory for site owners (plane B artifacts only for AgentOS).
pkg_tar(
    name = "release",
    files = {
        "README.md": "README.md",
        ":pick_main_bundle": "agentos-search.mjs",
        ":pick_embed_bundle": "agentos-search-embed.mjs",
        ":manifest": "agentos-search.manifest.json",
        ":pick_runtime_bundle": "agentos-search-runtime.mjs",
        ":pick_worker_bundle": "agentos-search-sw.mjs",
        "//index:schema.sql": "index/schema.sql",
        ":product_image": "search-atlas.tar",
        ":runtime/kernel.wasm": "kernel.wasm",
        ":runtime/catalog-compiler.wasm": "catalog-compiler.wasm",
        ":runtime/mc-core.mjs": "mc-core.mjs",
        "//guest/searchd:protocol": "searchd/searchd.protocol.json",
        ":model/model.onnx": "model/model.onnx",
        ":model/tokenizer.json": "model/tokenizer.json",
        ":model/tokenizer_config.json": "model/tokenizer_config.json",
        ":model/config.json": "model/config.json",
        ":model/runtime/ort-wasm-simd-threaded.jsep.mjs": "model/runtime/ort-wasm-simd-threaded.jsep.mjs",
        ":model/runtime/ort-wasm-simd-threaded.jsep.wasm": "model/runtime/ort-wasm-simd-threaded.jsep.wasm",
    },
    owner = "0.0",
    package_dir = "agentos-search",
)

search_typecheck(
    name = "typecheck",
    chdir = ".",
    tsconfig = "tsconfig.json",
)

test_suite(
    name = "check",
    tests = [
        ":typecheck",
        "//test:logic_test",
        "//demo:typecheck",
    ],
)
