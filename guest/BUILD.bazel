package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
        allow_empty = True,
    ),
)

alias(
    name = "searchd_protocol",
    actual = "//guest/searchd:protocol",
)

alias(
    name = "search_atlas",
    actual = "//guest/image:search_atlas",
)
