load("@agent-os//bazel:mc_program.bzl", "mc_rust_program", "mc_service_layer")
load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "searchd.protocol.json",
    "README.md",
])

# /svc/searchd — product-local site-search authority (built with @agent-os mc_program).
# Stitches /svc/sqlite + /svc/tools. Protocol: searchd.protocol.json.

rust_binary(
    name = "searchd_bin",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    edition = "2021",
    tags = ["manual"],
    deps = [
        "@agent-os//memcontainers/lib/json:lib",
        "@agent-os//memcontainers/sysroot/rust:lib",
        # Same dynamic allocator as agent-os /svc/tools (not a 32MiB static BSS).
        # Canonical label for agent-os crate_universe talc (root has no @crates alias).
        "@@rules_rust++crate+crates//:talc",
    ],
)

mc_rust_program(
    name = "searchd",
    fuel = 2000000000000,
    lib = ":searchd_bin",
    # Ceiling for the service task — not a pre-reserved slab. Keep aligned with
    # sqlite (64MiB) rather than tools/adapters (256MiB host-call buffers).
    mem = 64 * 1024 * 1024,
    service = "searchd",
    table = 10000,
    tier = "full",
)

mc_service_layer(
    name = "searchd_layer",
    eager = [":searchd"],
)

filegroup(
    name = "protocol",
    srcs = ["searchd.protocol.json"],
)
