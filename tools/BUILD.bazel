package(default_visibility = ["//visibility:public"])

exports_files([
    "bundle.mjs",
    "manifest.mjs",
    "browser-harness.mjs",
    "browser-e2e.mjs",
    "package-prewarm.mjs",
    "browserify-mc-core.mjs",
])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
        allow_empty = True,
    ),
)

