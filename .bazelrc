# search-experience — product root; AgentOS via git_override

common --enable_bzlmod
common --enable_workspace=false
common --enable_runfiles
common --incompatible_strict_action_env
common --lockfile_mode=update
common --registry=https://bcr.bazel.build/

# Match AgentOS guest/tooling needs (Zig caches, hermetic cc)
build --sandbox_add_mount_pair=/tmp
build --sandbox_add_mount_pair=/home

test --test_output=errors

# Match AgentOS guest/tooling needs for nested @agent-os C/C++/Zig
common --copt=-w
common --host_copt=-w
build --copt=-fno-sanitize=undefined --host_copt=-fno-sanitize=undefined
build --linkopt=-fno-sanitize=undefined --host_linkopt=-fno-sanitize=undefined

# Shared output root keeps large guest builds off small home partitions
startup --output_user_root=/mnt/workspace/search-experience-bazel
