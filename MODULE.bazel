"""search-experience — AgentOS site-search product.

Platform runtime (kernel, atlas, mc-core, catalog-compiler) is consumed from
AgentOS GitHub releases via http_file. Guest services (searchd) are built via
the AgentOS build graph in a sibling checkout and re-pinned here as digests.
JS/TS uses vendored rules_bun for hermetic deps and live-workspace HMR.
"""

module(name = "search-experience", version = "0.1.0")

bazel_dep(name = "rules_bun", version = "0.0.0")
local_path_override(
    module_name = "rules_bun",
    path = "bazel/rules_bun",
)

bun = use_extension("@rules_bun//bun:extensions.bzl", "bun")
bun.toolchain(version = "1.3.11")
use_repo(bun, "bun")

register_toolchains("@bun//:toolchain_def")

bun_deps = use_extension("@rules_bun//bun:extensions.bzl", "bun_deps")
bun_deps.install(
    name = "js_deps",
    bunfig = "//:bunfig.toml",
    lock = "//:bun.lock",
    package_json = "//:package.json",
    workspace_files = [
        "//demo:package.json",
    ],
)
use_repo(bun_deps, "js_deps")

bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# ---------------------------------------------------------------------------
# AgentOS platform runtime — release pins (train A)
# Bump AGENTOS_TAG + digests together; product release notes the platform tag.
# ---------------------------------------------------------------------------
_AGENTOS_TAG = "v0.5.0"
_AGENTOS_BASE = "https://github.com/NarendraPatwardhan/agent-os/releases/download/" + _AGENTOS_TAG

http_file(
    name = "agentos_kernel",
    downloaded_file_path = "kernel.wasm",
    sha256 = "ab20b493f4d2fdd90a4e40b005d495d3cb15af4121167ce977a719beffe77008",
    urls = [_AGENTOS_BASE + "/kernel.wasm"],
)

http_file(
    name = "agentos_atlas",
    downloaded_file_path = "atlas.tar",
    sha256 = "3e970d471ef0434fca540badf757858686fa011b62416b310baffd7f77215d03",
    urls = [_AGENTOS_BASE + "/atlas.tar"],
)

http_file(
    name = "mc_core_mjs",
    downloaded_file_path = "mc-core.mjs",
    sha256 = "cd6e07185c79a642eadcaa29f477ebc273b5852395f957443e5cff736e96aa42",
    urls = [_AGENTOS_BASE + "/mc-core.mjs"],
