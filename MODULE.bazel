"""search-experience — AgentOS site-search product.

AgentOS is a git-pinned Bazel module. Guest compilation (searchd, search-atlas)
and runtime artifacts (kernel, mc-core, catalog-compiler) come from @agent-os//…
labels built from that pin — not from prebuilt release downloads.

bzlmod only applies overrides from the root module. AgentOS assumes it is root
for some extensions (elixir, hermetic_cc @zig_sdk). This MODULE re-hosts
hermetic_cc at root and patches AgentOS to drop the Elixir/server block (not
needed for guest wasm / searchd).
"""

module(name = "search-experience", version = "0.1.0")

# ---------------------------------------------------------------------------
# AgentOS — git-pinned external module
#
# License: Business Source License 1.1 (BSL 1.1), licensor opyt.cloud.
# This product is Apache-2.0; AgentOS itself is not. Fetching and linking
# @agent-os is subject to upstream BSL terms (see that repo's LICENSE).
# Change license on the Change Date is Apache-2.0 per upstream parameters.
# ---------------------------------------------------------------------------
bazel_dep(name = "agent-os", version = "0.0.0")

git_override(
    module_name = "agent-os",
    commit = "fc32ef642edf65357d62a5bc6796f04bd2d3861f",
    patch_strip = 1,
    patches = [
        # Nested modules cannot use include(). Flatten AgentOS MODULE includes
        # here and drop the OTP/Elixir server lane (not needed for guest wasm).
        "//third_party/agent-os:0001-module-strip-elixir-server.patch",
    ],
    remote = "https://github.com/OpytAI/agent-os.git",
)

# archive_override is root-only. Re-host AgentOS's 0.0.0 module pins here so
# the nested @agent-os graph resolves the same commits.
GITZ_COMMIT = "fdf9124c2aab83b6c3297be4bae8045ada7661f8"
UTILZ_COMMIT = "eca2dc637a448839f76f67a329650f55a8d07954"
SHCORE_COMMIT = "2817e8c9eb98ad9bec8f6c8d787ca6cad66cd865"
TWIGZ_COMMIT = "767d8483bd238546bb548036b1b227a390c831db"
LUAUC_COMMIT = "7bb2b5c8a25d3fd189bfba04f7ae832cbece8836"

bazel_dep(name = "gitz", version = "0.0.0")
archive_override(
    module_name = "gitz",
    integrity = "sha256-maNtI/Q1Vt7LeW1d2bltDvnBUy/WQVX9ZOEXj33TOuc=",
    strip_prefix = "gitz-" + GITZ_COMMIT,
    url = "https://github.com/OpytAI/gitz/archive/" + GITZ_COMMIT + ".tar.gz",
)

bazel_dep(name = "utilz", version = "0.0.0")
archive_override(
    module_name = "utilz",
    integrity = "sha256-hcec1665890F8LgMx8NxugM3U7NsIrUgXEnGcwM4Dvs=",
    strip_prefix = "utilz-" + UTILZ_COMMIT,
    url = "https://github.com/OpytAI/utilz/archive/" + UTILZ_COMMIT + ".tar.gz",
)

bazel_dep(name = "shcore", version = "0.0.0")
archive_override(
    module_name = "shcore",
    integrity = "sha256-SlDvHw+OXUyNDBqjtzBzXEtpfMZLuYnLcIZgVUEd0TQ=",
    strip_prefix = "shcore-" + SHCORE_COMMIT,
    url = "https://github.com/OpytAI/shcore/archive/" + SHCORE_COMMIT + ".tar.gz",
)

bazel_dep(name = "twigz", version = "0.0.0")
archive_override(
    module_name = "twigz",
    integrity = "sha256-R9CpdQM4/J0BEYCOD02EkDs0rrEUp+L7bZoxEoBjkmY=",
    strip_prefix = "twigz-" + TWIGZ_COMMIT,
    url = "https://github.com/OpytAI/twigz/archive/" + TWIGZ_COMMIT + ".tar.gz",
)

bazel_dep(name = "luauc", version = "0.0.0")
archive_override(
    module_name = "luauc",
    integrity = "sha256-So4Rk+jLU8DXlrKWEwcs/3oTsGOMsMM3jkeKzkQ5ozU=",
    strip_prefix = "luauc-" + LUAUC_COMMIT,
    url = "https://github.com/OpytAI/luauc/archive/" + LUAUC_COMMIT + ".tar.gz",
)

# hermetic_cc only materializes @zig_sdk when the **root** module uses the extension
# (see hermetic_cc_toolchain toolchain/ext.bzl). AgentOS imports zig_sdk for
# git-engine; root must instantiate the extension.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.2.0")

hermetic_cc = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(hermetic_cc, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
)

# Product JS toolchain (product-local rules_bun only)
bazel_dep(name = "rules_bun", version = "0.0.0")
local_path_override(
    module_name = "rules_bun",
    path = "bazel/rules_bun",
)

bun = use_extension("@rules_bun//bun:extensions.bzl", "bun")
bun.toolchain(version = "1.3.11")
use_repo(bun, "bun")

register_toolchains("@bun//:toolchain_def")

bun_deps = use_extension("@rules_bun//bun:extensions.bzl", "bun_deps")
bun_deps.install(
    name = "js_deps",
    bunfig = "//:bunfig.toml",
    lock = "//:bun.lock",
    package_json = "//:package.json",
    workspace_files = [
        "//docs:package.json",
    ],
)
use_repo(bun_deps, "js_deps")

bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "rules_cc", version = "0.2.18")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

