"""search-experience — AgentOS site-search product (Strategy B).

AgentOS is a **git-pinned Bazel module** dependency. Guest compilation (searchd,
search-atlas) and runtime artifacts (kernel, atlas, mc-core, catalog-compiler)
come from @agent-os//… labels.

Dharma note: bzlmod only applies overrides from the **root** module. AgentOS was
designed as root (elixir overrides, hermetic_cc zig_sdk only generated for root).
This MODULE re-hosts the hermetic_cc extension at root and patches AgentOS to
drop the Elixir/server block (not needed for guest wasm / searchd).
"""

module(name = "search-experience", version = "0.1.0")

# ---------------------------------------------------------------------------
# AgentOS — plane B from Git
# ---------------------------------------------------------------------------
bazel_dep(name = "agent-os", version = "0.0.0")

git_override(
    module_name = "agent-os",
    commit = "1b5bbc116c60d98b01c80e96d65caf3d628c1fcb",
    patch_strip = 1,
    patches = [
        "//third_party/agent-os:0001-module-strip-elixir-server.patch",
        "//third_party/agent-os:0002-tree-sitter-load-agent-os.patch",
        # Luau glue copts used main-repo-relative -include paths; under @agent-os those
        # resolve as missing headers and surface as zig CacheCheckFailed on every .cpp.
        "//third_party/agent-os:0003-luau-include-external-root.patch",
    ],
    remote = "https://github.com/NarendraPatwardhan/agent-os.git",
)

# hermetic_cc only materializes @zig_sdk when the **root** module uses the extension
# (see hermetic_cc_toolchain toolchain/ext.bzl). AgentOS imports zig_sdk for
# git-engine; root must instantiate the extension.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.2.0")

hermetic_cc = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(hermetic_cc, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
)

# Product JS toolchain (product-local rules_bun only)
bazel_dep(name = "rules_bun", version = "0.0.0")
local_path_override(
    module_name = "rules_bun",
    path = "bazel/rules_bun",
)

bun = use_extension("@rules_bun//bun:extensions.bzl", "bun")
bun.toolchain(version = "1.3.11")
use_repo(bun, "bun")

register_toolchains("@bun//:toolchain_def")

bun_deps = use_extension("@rules_bun//bun:extensions.bzl", "bun_deps")
bun_deps.install(
    name = "js_deps",
    bunfig = "//:bunfig.toml",
    lock = "//:bun.lock",
    package_json = "//:package.json",
    workspace_files = [
        "//demo:package.json",
    ],
)
use_repo(bun_deps, "js_deps")

bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "rules_cc", version = "0.2.18")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# ---------------------------------------------------------------------------
# Product-owned embedding model + ONNX Runtime
# ---------------------------------------------------------------------------
http_file(
    name = "mxbai_embed_xsmall_v1_uint8",
    downloaded_file_path = "model.onnx",
    sha256 = "b423ee3c9b2926f859fedb977bfadbe7c6dd0108c3bb623a422f71c681708a18",
    urls = ["https://huggingface.co/mixedbread-ai/mxbai-embed-xsmall-v1/resolve/e6ac24e5d6efb8782b59de1647b3ececb4ece94e/onnx/model_uint8.onnx"],
)

http_file(
    name = "mxbai_embed_xsmall_v1_tokenizer",
    downloaded_file_path = "tokenizer.json",
    sha256 = "da0e79933b9ed51798a3ae27893d3c5fa4a201126cef75586296df9b4d2c62a0",
    urls = ["https://huggingface.co/mixedbread-ai/mxbai-embed-xsmall-v1/resolve/e6ac24e5d6efb8782b59de1647b3ececb4ece94e/tokenizer.json"],
)

http_file(
    name = "mxbai_embed_xsmall_v1_tokenizer_config",
    downloaded_file_path = "tokenizer_config.json",
    sha256 = "bd2e06a5b20fd1b13ca988bedc8763d332d242381b4fbc98f8fead4524158f79",
    urls = ["https://huggingface.co/mixedbread-ai/mxbai-embed-xsmall-v1/resolve/e6ac24e5d6efb8782b59de1647b3ececb4ece94e/tokenizer_config.json"],
