load("//bazel:search.bzl", "search_build_binary", "search_dev_binary", "search_typecheck")

package(default_visibility = ["//visibility:public"])

exports_files(["package.json"])

filegroup(
    name = "sources",
    srcs = ["BUILD.bazel"] + glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "dist/**",
            "node_modules/**",
            "public/agentos-search/**",
        ],
    ),
)

# Typecheck docs + product sources from the repo root so product imports under src/ resolve.
search_typecheck(
    name = "typecheck",
    chdir = ".",
    tsconfig = "docs/tsconfig.json",
)

# Vite-only runner (live workspace). Prefer //docs:dev which stages //:release first.
search_dev_binary(
    name = "_dev_vite",
    chdir = "docs",
    fixed_args = [
        "node_modules/.bin/vite",
        "dev",
        "--host",
        "127.0.0.1",
        "--port",
        "5191",
    ],
)

# Public entry: rebuild release when needed, unpack to docs/public/agentos-search (gitignored), run Vite.
# This is the whole point of Bazel — no manual tar step.
sh_binary(
    name = "dev",
    srcs = ["dev_launch.sh"],
    data = [
        ":_dev_vite",
        "//:release",
    ],
)

search_build_binary(
    name = "app",
    chdir = "docs",
    fixed_args = [
        "node_modules/.bin/vite",
        "build",
    ],
    out_dir = "dist",
)
